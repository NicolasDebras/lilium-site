# Base Postgres partagée avec le bot (Railway → service Postgres → Variables → DATABASE_PUBLIC_URL)
# ⚠️ En local c'est la VRAIE base : ce que tu crées/supprimes sur le site est réel.
DATABASE_URL=postgresql://postgres:motdepasse@xxxx.proxy.rlwy.net:12345/railway

# Token du bot Discord (même que DISCORD_TOKEN du bot) — sert à vérifier les rôles des membres
DISCORD_TOKEN=

# Application Discord → OAuth2 (Client ID / Client Secret) + redirect à déclarer dans le portail
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4200/api/auth/callback

# Chaîne aléatoire longue (signature du cookie de session) — au moins 16 caractères, refusée sinon.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# URL du frontend (redirection après login / logout)
FRONTEND_URL=http://localhost:4200
# true en prod (HTTPS) ; false en local (http://localhost)
COOKIE_SECURE=false

# Prod uniquement (déjà fixé dans le Dockerfile) : dossier du front compilé servi par l'API.
# STATIC_DIR=/app/static
